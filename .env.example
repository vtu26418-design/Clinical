APP_ENV=development
# Session authentication is the default. Setup generates a unique token below.
AUTH_MODE=session
SETUP_TOKEN=
SESSION_HOURS=12
# Optional authenticated-account email verification via the fixed Resend HTTPS API.
# Required mode needs session auth and a configured mail service.
REQUIRE_EMAIL_VERIFICATION=false
MAIL_API_KEY=
MAIL_FROM=
# HTTPS public application root; verification tokens use a URL fragment.
PUBLIC_BASE_URL=
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=./data/workbench
FRONTEND_DIST=./frontend/dist
# PostgreSQL is required in every mode. Setup generates a unique password and URL.
# Native startup uses DATABASE_URL; Compose uses the same credentials internally.
POSTGRES_USER=cti
POSTGRES_DB=cti
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Use a provider's TLS connection string for remote production PostgreSQL.
# Production requires sslmode=require,
# verify-ca or verify-full (prefer verify-full when its trusted CA is configured).
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=
# Optional remote/TLS URL for the Compose workbench; empty uses its postgres service.
COMPOSE_DATABASE_URL=
# A separate disposable PostgreSQL database is required for the test suite.
TEST_DATABASE_URL=
# Empty ignores forwarding headers. Only configured proxy IPs/CIDRs are trusted.
TRUSTED_PROXY_HOSTS=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_TRAINING=10
RATE_LIMIT_ASSISTANT=30
# Fill one or more provider keys locally; leave unused keys empty. Never use VITE_ keys.
AI_PROVIDER=auto
AI_PROVIDER_PRIORITY=openai,anthropic,gemini,compatible
AI_AUTO_FALLBACK=true
AI_MAX_OUTPUT_TOKENS=16000
AI_CONTEXT_CHARS=120000
# Set an API model ID your provider account can access; coding-app labels are not API IDs.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional OTHER provider implementing OpenAI Chat Completions. Use its own key.
COMPATIBLE_API_KEY=
# Exact HTTPS API root, often ending /v1; no /chat/completions suffix.
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=
# Internal legacy research-worker setting. It is not a v5 session credential.
API_BEARER_TOKEN=
IMPORT_ALLOWED_HOSTS=clinicaltrials.gov,raw.githubusercontent.com
MAX_PROJECTS_PER_USER=30
MAX_CONVERSATIONS_PER_USER=200
MAX_MESSAGES_PER_CONVERSATION=200
MAX_UPLOAD_BYTES=26214400
MAX_DATASET_ROWS=100000
MAX_TRAINING_ROWS=20000
AACT_SNAPSHOT_PATH=./data/raw/aact_snapshot
PROCESSED_DATA_PATH=./data/processed
