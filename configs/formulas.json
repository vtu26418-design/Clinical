{
  "schema_version": 1,
  "fixed_reference_pci": {
    "id": "fixed_reference_pci_v1",
    "name": "Fixed-reference descriptive PCI",
    "score_min": 0,
    "score_max": 100,
    "components": [
      {
        "key": "criteria_count",
        "label": "Eligibility burden",
        "ceiling": 40,
        "weight": 25
      },
      {
        "key": "primary_outcomes",
        "label": "Primary outcome burden",
        "ceiling": 10,
        "weight": 20
      },
      {
        "key": "secondary_outcomes",
        "label": "Secondary outcome burden",
        "ceiling": 20,
        "weight": 20
      },
      {
        "key": "number_of_arms",
        "label": "Arm complexity",
        "ceiling": 8,
        "weight": 15
      },
      {
        "key": "enrollment",
        "label": "Enrollment burden",
        "ceiling": 1000,
        "weight": 10
      },
      {
        "key": "text_complexity",
        "label": "Text complexity",
        "ceiling": 20,
        "weight": 10
      }
    ],
    "formula": "sum(weight_i * clip(value_i / ceiling_i, 0, 1))",
    "rounding": {
      "digits": 2,
      "mode": "half_up",
      "arithmetic": "exact_decimal_rational",
      "category_basis": "rounded_score"
    },
    "categories": [
      {
        "label": "Low",
        "upper": 40,
        "upper_inclusive": false
      },
      {
        "label": "Medium",
        "upper": 70,
        "upper_inclusive": true
      },
      {
        "label": "High",
        "upper": 100,
        "upper_inclusive": true
      }
    ],
    "input_policy": {
      "accepted": "finite numeric scalar or trimmed decimal/scientific numeric string",
      "decimal_pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
      "invalid": "missing, null, empty, boolean, object, array, malformed or non-finite values contribute zero and are disclosed",
      "negative": "finite negative values clip to zero; they are not missing",
      "numeric_semantics": "use decimal text representation of numeric inputs; preserve accepted numeric strings for exact arithmetic",
      "max_decimal_digits": 340,
      "max_absolute_decimal_scale": 320,
      "resource_bounds": "Reject mantissas with more than 340 digits, or abs(scientific exponent minus fractional digit count) > 320, before constructing exact integers."
    },
    "custom_weights": {
      "scope": "Exploratory user assumptions; not fixed-reference PCI",
      "count": 6,
      "minimum": 0,
      "maximum": 100,
      "sum": 100,
      "invalid": "reject non-finite, negative, incorrect-count, out-of-bounds, or non-normalized weights",
      "sum_tolerance": 1e-08
    },
    "methodology": "Fixed-reference descriptive PCI (0–100): eligibility 25%, primary outcomes 20%, secondary outcomes 20%, arms 15%, enrollment 10%, text complexity 10%. Fixed component ceilings: 40, 10, 20, 8, 1000, 20 respectively. Missing, invalid and non-finite components contribute zero and are disclosed in missing_fields, so incomplete records may be understated. Clip each normalized component to [0,1]; sum unrounded weighted terms; round the total to two decimals, exact decimal half-up. Categorize the rounded score: Low <40, Medium 40–70 inclusive, High >70. These are explicit research assumptions, not a clinically validated score, clinical thresholds, causal forecasts or duration probabilities. Training-relative research PCI is a separate methodology.",
    "validated": false
  },
  "metrics": {
    "mae": {
      "name": "Mean absolute error",
      "formula": "sum(abs(y_i - estimate_i)) / n",
      "unit": "same as outcome",
      "undefined": "empty inputs"
    },
    "rmse": {
      "name": "Root mean squared error",
      "formula": "sqrt(sum((y_i - estimate_i)^2) / n)",
      "unit": "same as outcome",
      "undefined": "empty inputs"
    },
    "r2": {
      "name": "Coefficient of determination",
      "formula": "1 - sum((y_i - estimate_i)^2) / sum((y_i - mean(y))^2)",
      "unit": "unitless",
      "undefined": "n < 2 or zero variation in actual outcomes; return null"
    },
    "brier": {
      "name": "Binary Brier score",
      "formula": "sum((p_i - binary_y_i)^2) / n",
      "unit": "unitless",
      "bounds": [
        0,
        1
      ],
      "undefined": "empty inputs",
      "inputs": "labels exactly 0/1; probabilities finite and in [0,1]"
    },
    "cosine": {
      "name": "Cosine similarity",
      "formula": "dot(a,b) / (sqrt(dot(a,a)) * sqrt(dot(b,b)))",
      "unit": "unitless",
      "undefined": "mathematically undefined for a zero vector; retrieval convention returns zero and omits zero-score results",
      "scope": "TF-IDF descriptive text retrieval, not clinical equivalence"
    }
  },
  "planning": {
    "id": "deterministic_recruitment_planning_v1",
    "recruitment_months": "target_enrollment / (sites * monthly_rate_per_site)",
    "total_months": "startup_months + recruitment_months + followup_months",
    "inputs": "finite non-negative target/startup/followup; finite positive sites and rate; scenario target overrides source target; missing target refuses calculation",
    "scope": "Arithmetic under explicit assumptions; no recruitment risk probability or causal forecast"
  },
